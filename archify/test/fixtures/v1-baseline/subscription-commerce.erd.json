  "cards": [
    {
      "dot": "cyan",
      "title": "Reading the model",
      "items": [
        "Every relationship states cardinality on both ends in crow's-foot notation.",
        "order_items is a junction table: its composite key (order_id, product_id) resolves the orders–products many-to-many.",
        "idp_users is owned by the identity provider; customers.idp_subject is the local foreign key."
      ]
    },
    {
      "dot": "emerald",
      "title": "Key conventions",
      "items": [
        "PK marks primary-key attributes; composite keys repeat the badge across rows.",
        "FK marks foreign keys that realize a drawn relationship.",
        "UQ marks unique constraints such as customer email and product slug."
      ]
    }
  ]
